{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quickque",
  "version": "0.1.0",
  "identifier": "com.quickque.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite --config vite.desktop.config.ts",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm vite build --config vite.desktop.config.ts",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Quickque",
        "width": 1180,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "main-window"
      ],
      "csp": "default-src 'self'; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/quickque-flow",
      "binaries/quickque-speech",
      "binaries/quickque-audio-export"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "A focused prompt queue for presentations and recordings.",
    "macOS": {
      "minimumSystemVersion": "26.0",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../turbo/dist/quickque-turbo/": "turbo-runtime/"
    }
  }
}
