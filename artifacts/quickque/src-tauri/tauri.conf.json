{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quickque",
  "version": "0.1.0",
  "identifier": "com.quickque.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite --config vite.desktop.config.ts",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm vite build --config vite.desktop.config.ts",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Quickque",
        "width": 1180,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self'; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/quickque-flow"],
    "resources": ["../native/THIRD_PARTY_NOTICES.txt"],
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A focused prompt queue for presentations and recordings.",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    }
  }
}