{
  "expo": {
    "name": "Quickque Mobile",
    "slug": "quickque-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quickque-icon.png",
    "scheme": "quickque-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quickque.mobile"
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
