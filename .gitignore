# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
dist-desktop
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Codex transient runtime state
/.codex/*_cache.json
/.codex/*.sqlite-shm
/.codex/*.sqlite-wal

# Browser regression artifacts
**/test-results/
**/playwright-report/

# Bundled Chatterbox build outputs
/artifacts/quickque/turbo/.venv/
/artifacts/quickque/turbo/build/
/artifacts/quickque/turbo/dist/
/artifacts/quickque/turbo/*.spec
/artifacts/quickque/turbo/__pycache__/

# Standalone licence verifier build output
/lib/licence-core/target/

# Rust build outputs
**/target/
